PORT=5000
NODE_ENV=development

# 🗄️ Database
# Local MongoDB (default — see README for install steps)
MONGO_URI=mongodb://127.0.0.1:27017/readcycle
# To use MongoDB Atlas instead, replace the line above with your own connection
# string from https://cloud.mongodb.com, e.g.:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/readcycle?appName=Cluster0

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=5242880

# 🌍 Client URL (Frontend)
CLIENT_URL=http://localhost:3000

# 🛠 Admin Account (for seeding or admin login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# 💬 Socket (optional for chat feature)
SOCKET_PORT=5001
